# Informações do Banco de Dados
DB_USER=
DB_PASSWORD=
DB_NAME=
DB_HOST=
DB_PORT=


# Chaves de Segurança
PASS_PEPPER=
NANIKA_JWT_SECRET=


# APIs Externas (Email)
RESEND_API_KEY=
EMAIL_VALIDATION_API_KEY=


# APIs Externas 
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=


# Configurações do Armazenamento
NANIKA_STORAGE_PATH=


# CORS
CORS_ORIGIN=http://127.0.0.1:4200
CORS_ALLOWED_ORIGINS=http://127.0.0.1:4200,http://localhost:4200,https://nanika.lvinik.app
# true somente quando o backend estiver acessível apenas pelo Nginx confiável.
TRUST_PROXY_HEADERS=false

# Endereço de escuta do backend: 0.0.0.0 para Docker; 127.0.0.1 para execução nativa local.
NANIKA_BIND_ADDRESS=0.0.0.0

# PORTA
PORT=8080
FRONTEND_PORT=6742

# Informações do Google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
