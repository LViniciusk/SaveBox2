{
  "name": "frontend",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:coverage": "ng test --watch=false --browsers=ChromeHeadless --code-coverage",
    "e2e": "playwright test",
    "e2e:chromium": "playwright test --project=chromium",
    "e2e:video": "playwright test --config=playwright.video.config.ts",
    "e2e:headed": "playwright test --headed",
    "quality:dead": "knip --no-exit-code",
    "quality:dead:prod": "knip --production --no-exit-code",
    "quality:cycles": "knip --cycles --no-exit-code",
    "quality:mutation": "stryker run",
    "quality:mp4-resource": "node --expose-gc tools/mp4-resource-calibration.mjs",
    "quality:mp4-resource:audit": "node --expose-gc tools/mp4-ap01-independent-audit.mjs",
    "quality:mp4-resource:aux": "node --expose-gc tools/mp4-auxiliary-resource-probe.mjs",
    "quality:mp4-parser-surface": "node tools/mp4-parser-surface-inventory.mjs",
    "quality:mp4-resource:test": "node --test tools/mp4-resource-calibration.test.mjs tools/mp4-auxiliary-resource-probe.test.mjs tools/mp4-ap01-independent-audit.test.mjs"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "dependencies": {
    "@angular/common": "^20.3.31",
    "@angular/compiler": "^20.3.31",
    "@angular/core": "^20.3.31",
    "@angular/forms": "^20.3.31",
    "@angular/platform-browser": "^20.3.31",
    "@angular/router": "^20.3.31",
    "@ffmpeg/ffmpeg": "^0.12.15",
    "@ffmpeg/util": "^0.12.2",
    "libsodium-wrappers-sumo": "^0.8.4",
    "mp4box": "2.4.1",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^20.2.2",
    "@angular/cli": "^20.2.2",
    "@angular/compiler-cli": "^20.3.31",
    "@playwright/test": "1.62.1",
    "@stryker-mutator/core": "9.6.1",
    "@stryker-mutator/karma-runner": "9.6.1",
    "@stryker-mutator/typescript-checker": "9.6.1",
    "@types/jasmine": "~5.1.0",
    "jasmine-core": "~5.9.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "knip": "6.32.2",
    "typescript": "~5.9.2"
  }
}
